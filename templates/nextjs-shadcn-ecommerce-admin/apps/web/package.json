{
	"name": "{{name}}-web",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "22.x",
		"pnpm": "10.x"
	},
	"scripts": {
		"dev": "infisical run --env=dev --path=/web -- next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"check-types": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"sort": "biome check --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=true --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"generate:api": "orval --config orval.config.ts"
	},
