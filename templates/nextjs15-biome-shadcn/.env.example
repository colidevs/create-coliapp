# Required by @colidevs/ui's ThumborImage component: Thumbor uses this to sign (HMAC) the
# image URL. ThumborImage reads it itself via process.env.SECURITY_KEY and passes it explicitly
# to @colidevs/thumbor-client's buildThumborUrl — that package deliberately never reads it from
# its own env var (forces every caller to consciously decide where it comes from; never
# NEXT_PUBLIC_*). Server-only, never expose to the client.
SECURITY_KEY=

# Optional, only relevant if ThumborImage/buildThumborUrl is used: default for the Thumbor
# endpoint's baseUrl if none is passed explicitly.
THUMBOR_BASE_URL=
