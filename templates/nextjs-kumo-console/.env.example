# Base URL the DAL (src/lib/dal.ts) and any future generated API client fetch
# against, server-side. Points at the MSW-mocked backend by default; switch
# to a running templates/express-ts instance's own base URL (its own
# config.port is 3001) once one exists — no code change needed, only these
# three env vars (this one, API_MOCKING below, and NEXT_PUBLIC_API_BASE_URL).
API_BASE_URL=http://localhost:3000

# Starts the MSW Node server (src/mocks/node.ts) from src/instrumentation.ts,
# and selects the MSW/demo login path (src/app/login/page.tsx) over the real
# Better Auth one. Set to anything other than "enabled" (or unset) once
# API_BASE_URL points at a real backend.
API_MOCKING=enabled

# Browser-side counterpart of API_BASE_URL, read by src/lib/auth-client.ts
# (Better Auth's React client, Arc A4). Must be NEXT_PUBLIC_* — Next.js only
# inlines that prefix into the client bundle; the plain API_BASE_URL above is
# never readable from browser code. Keep both pointed at the same
# templates/express-ts instance. Requires that backend's CORS_ALLOWED_ORIGINS
# (and, for cookies, `credentials: true` on its cors() middleware) to include
# this app's own dev origin (http://localhost:3000) — see this template's PR
# description for the exact express-ts follow-up this depends on.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Thumbor image signing (src/lib/thumbor.ts, @colidevs/thumbor-client,
# frontend-performance-tooling.md). Placeholder values only — a real value
# comes from Infisical in a real deployment (.claude/rules/secrets-management.md).
# THUMBOR_SECURITY_KEY must never be a NEXT_PUBLIC_* var; buildSignedThumborUrl
# is only ever called server-side.
THUMBOR_BASE_URL=https://images.colidevs.com
THUMBOR_SECURITY_KEY=replace-with-a-real-thumbor-security-key
