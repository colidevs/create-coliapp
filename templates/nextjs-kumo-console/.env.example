# Base URL the DAL (src/lib/dal.ts) and any future generated API client fetch
# against. Points at the MSW-mocked backend by default; switch to a running
# templates/express-ts instance's own base URL once one exists — no code
# change needed, only these two env vars.
API_BASE_URL=http://localhost:3000

# Starts the MSW Node server (src/mocks/node.ts) from src/instrumentation.ts.
# Set to anything other than "enabled" (or unset) once API_BASE_URL points at
# a real backend.
API_MOCKING=enabled
