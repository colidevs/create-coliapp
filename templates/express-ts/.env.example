# Better Auth (bearer + emailAndPassword only; organization/passkey plugins
# and the PostgREST/JWT bridge are deliberately deferred — see hefesto's
# docs/backlog/e2e-buildable-toolset-plan.md Arc A1/A2). Reuses
# DATABASE_RUNTIME_URL below for its own tables, no separate DB connection
# string.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Redis
REDIS_URL=

API_URL=
SECRETS_ENDPOINT=

# Secret - Encrypt - Cipher
# openssl run -hex 32
SECRET_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Payments
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# Database
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Plain-Postgres/Drizzle data-access path (src/lib/db/) — pick this OR the
# PostgREST path below, not both. Owner role for migrations only
# (drizzle-kit), runtime role (NOBYPASSRLS) for the running app.
DATABASE_OWNER_URL=
DATABASE_RUNTIME_URL=

# Supabase-hosted/PostgREST data-access path (src/lib/postgrest/).
POSTGREST_URL=

# CORS: comma-separated explicit origin allow-list. Empty = no browser
# origin allowed (fail closed), never "*".
CORS_ALLOWED_ORIGINS=

# Infisical (pnpm dev:infisical) — the project UUID, matching this app's
# INFISICAL_PROJECT_SLUG/INFISICAL_SECRET_PATH in colidevs/infra's
# apps/<INFRA_APP_PATH>/deploy.config once deployed. See README.md.
INFISICAL_PROJECT_ID=