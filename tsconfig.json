{
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["index.ts"],
	"exclude": ["node_modules", "dist", "templates"]
}
