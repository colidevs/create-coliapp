# Base URL apps/web's server-side code (src/lib/api.ts, src/lib/
# get-server-session.ts) fetches apps/api against. Points at a running
# apps/api instance's own dev port (its config.ts default is 3001).
API_BASE_URL=http://localhost:3001

# Browser-side counterpart, read by src/lib/auth-client.ts (Better Auth's
# React client). Must be NEXT_PUBLIC_* — Next.js only inlines that prefix
# into the client bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Matches apps/api's own SERVICE_KEY (src/config.ts) — sent as the
# x-service-key header on every apps/api call (src/lib/api.ts). Service-to-
# service static-key auth (ADR 0009's carve-out), never a per-user credential.
SERVICE_KEY=

# Starts the MSW Node server (src/mocks/node.ts) from src/instrumentation.ts
# — the default dev backend for every catalog/order endpoint (design
# decision, `sdd/ecommerce-admin-template/design`). Set to anything other
# than "enabled" (or unset) once API_BASE_URL points at a real, running
# apps/api instance.
API_MOCKING=enabled
